# ============================================================================
# EcoTrack Office - Environment Variables Template
# ============================================================================
# Copy this file to .env.dev or .env.prod and fill in your values

# Database Configuration
DB_NAME=ecotrack
DB_USERNAME=ecotrack_user
DB_PASSWORD=your_secure_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here

# Spring Boot Configuration
SPRING_PROFILE=dev
SERVER_PORT=8080

# JWT Configuration
# IMPORTANT: Generate a strong secret key for production!
# You can generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRATION=86400000

# CORS Configuration
# Development: allow localhost
# Production: set to your actual domain
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://frontend:8080

# Frontend API Configuration
ANGULAR_API_URL=http://localhost:8080/api
API_BASE_URL=http://backend:8080/api

# Docker Configuration (for production)
DOCKER_REGISTRY=ghcr.io/your-username/
VERSION=1.0.0

# Logging
LOGGING_LEVEL_ROOT=DEBUG
LOGGING_LEVEL_COM_EDIAE=DEBUG
