# Minimal environment variables for Docker Compose

DB_NAME=ecotrack
DB_USERNAME=ecotrack_user
DB_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
JWT_SECRET=change_me_with_a_strong_random_value

# Optional
# JWT_EXPIRATION=86400000
# CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:4200
