services:
  - type: docker
    name: ecotrack-mysql
    env: docker
    plan: free
    branch: render
    image: mysql:8.0
    envVars:
      - key: MYSQL_DATABASE
        value: ecotrack
      - key: MYSQL_USER
        value: ecotrack_user
      - key: MYSQL_PASSWORD
        value: <REPLACE_WITH_MYSQL_PASSWORD>
      - key: MYSQL_ROOT_PASSWORD
        value: <REPLACE_WITH_ROOT_PASSWORD>
    persistentDisk:
      sizeGb: 10
      mountPath: /var/lib/mysql

  - type: docker
    name: ecotrack-backend
    env: docker
    plan: free
    branch: render
    dockerContext: ./back/ecotrack-office
    dockerfilePath: ./back/ecotrack-office/Dockerfile
    envVars:
      - key: DB_URL
        value: "jdbc:mysql://ecotrack-mysql:3306/ecotrack?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC"
      - key: DB_USERNAME
        value: ecotrack
      - key: DB_PASSWORD
        value: <REPLACE_WITH_MYSQL_PASSWORD>
      - key: JWT_SECRET
        value: <REPLACE_WITH_JWT_SECRET_OR_USE_RENDER_SECRETS>
      - key: SPRING_PROFILES_ACTIVE
        value: prod

  - type: docker
    name: ecotrack-frontend
    env: docker
    plan: free
    branch: render
    dockerContext: ./front/ecotrack-office
    dockerfilePath: ./front/ecotrack-office/Dockerfile
    envVars:
      - key: API_BASE_URL
        value: "http://ecotrack-backend:8080/api/"
