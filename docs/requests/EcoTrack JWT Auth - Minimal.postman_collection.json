                "exec": [
                  "pm.test('Employee - debe recibir 403', function () {",
                  "  pm.response.to.have.status(403);",
                  "});",
                  "",
                  "pm.test('Error code should be 2002', function () {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.code).to.equal(2002);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
