    {
      "name": "users",
      "item": [
        {
          "name": "Admin - List users by organization",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Obtain admin JWT and inject Authorization header for this request",
                  "var loginReq = {",
                  "  url: pm.variables.get('base_url') + '/auth/login',",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ email: 'admin@ecotrack.local', password: 'password' }) }",
                  "};",
                  "pm.sendRequest(loginReq, function (err, res) {",
                  "  if (err) { console.error(err); return; }",
                  "  var json = res.json();",
                  "  var token = json.token || json.accessToken || json.jwt || (json.data && json.data.token);",
                  "  if (!token) { console.error('No token in login response'); return; }",
                  "  pm.environment.set('jwt_token_admin', token);",
                  "  pm.environment.set('jwt_token', token);",
                  "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin - lista usuarios OK (200)', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users?organizationId=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "organizationId",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        },
        {
