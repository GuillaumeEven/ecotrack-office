                  "};",
                  "pm.sendRequest(loginReq, function (err, res) {",
                  "  if (err) { console.error(err); return; }",
                  "  var json = res.json();",
                  "  var token = json.token || json.accessToken || json.jwt || (json.data && json.data.token);",
                  "  if (!token) { console.error('No token in login response'); return; }",
                  "  pm.environment.set('jwt_token_employee', token);",
                  "  pm.environment.set('jwt_token', token);",
                  "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
                  "});"
                ],
                "type": "text/javascript"
