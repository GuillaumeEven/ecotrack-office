{
  "info": {
    "_postman_id": "ecotrack-office-v1",
    "name": "EcoTrack Office API",
    "description": "Collection générée depuis DataLoader (profil dev).\n\nIDs seedés garantis après reset :\n- Organization : id=1 (EcoTrack)\n- Users : admin id=1, tech id=2, employee id=3\n- Floors : level-0 id=1, level-1 id=2\n- Rooms : Desk Area A id=1, Desk Area B id=2\n- Desks : Desk 1 id=1, Desk 2 id=2, Desk 3 id=3\n\nBase URL : http://localhost:8080/api/v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
