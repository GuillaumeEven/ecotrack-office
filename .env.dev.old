# ============================================================================
# EcoTrack Office - Development Environment Variables
# ============================================================================

# Database Configuration
DB_NAME=ecotrack
DB_USERNAME=ecotrack_user
DB_PASSWORD=ecotrack_password
MYSQL_ROOT_PASSWORD=root_password

# Spring Boot Configuration
SPRING_PROFILE=dev
SERVER_PORT=8080

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=dev-secret-key-please-change-in-production-with-strong-value
JWT_EXPIRATION=86400000

# CORS Configuration (development allows localhost variants)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:4200,http://localhost:80,http://frontend:8080,http://backend:8080

# Frontend API Configuration
ANGULAR_API_URL=http://localhost:8080/api
API_BASE_URL=http://backend:8080/api

# Docker Configuration
BACKEND_VOLUME_PATH=.

# Logging
LOGGING_LEVEL_ROOT=DEBUG
LOGGING_LEVEL_COM_EDIAE=DEBUG
